            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="valign">start</property>
                <property name="label" translatable="yes">To create a route by typing a starting and ending intersection, use the 4 search bars. Type in the two streets of the intersection in each search bar to the right of the “Enter Starting Intersection:” text to select a starting intersection. Repeat for the ending intersection. Once each search bar has been filled out, click on the “create route” button to confirm. Once the button is pressed a pop up will appear that displays all the intersections of the starting streets, click on the desired intersection. Once clicked, Another pop up will appear to confirm the ending intersection. After confirming the intersections a route will appear on the map.</property>
                <property name="wrap">True</property>
                <property name="max-width-chars">80</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">3</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">1. Typing in intersections</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">2</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">2. Clicking mode</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">4</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="valign">start</property>
                <property name="label" translatable="yes">To create a route by clicking on intersections, click on the “Enter Route Clicking Mode” button. Left click on an intersection on the map to place a red pin indicating the starting intersection of the route. Right click on an intersection on the map to place a blue pin on the map indicating the ending intersection. Once both pins are placed, a route will appear on the map. During this mode, routes can easily be changed by placing these pins on different intersections. To exit the mode click on the red “Exit Route Mode” button will appear on the top of the map next to the “Change Map” button.</property>
                <property name="wrap">True</property>
                <property name="max-width-chars">80</property>
              </object>
              <packing>
                <property name="left-attach">0</property>
                <property name="top-attach">5</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="margin-top">5</property>
                <property name="label" translatable="yes">Search bar:</property>
